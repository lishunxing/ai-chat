<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.lishunxing.aichat.mapper.KnowledgeDocumentMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="cn.lishunxing.aichat.entity.KnowledgeDocument">
        <id     column="id"              property="id" />
        <result column="file_path"       property="filePath" />
        <result column="title"           property="title" />
        <result column="md5_hash"        property="md5Hash" />
        <result column="chunk_count"     property="chunkCount" />
        <result column="last_indexed_at" property="lastIndexedAt" />
    </resultMap>

    <!-- 根据文件路径查询 -->
    <select id="selectByFilePath" resultMap="BaseResultMap">
        SELECT id, file_path, title, md5_hash, chunk_count, last_indexed_at
        FROM knowledge_document
        WHERE file_path = #{filePath}
    </select>

    <!-- 根据文件路径删除 -->
    <delete id="deleteByFilePath">
        DELETE FROM knowledge_document
        WHERE file_path = #{filePath}
    </delete>

    <!-- 查询所有记录 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT id, file_path, title, md5_hash, chunk_count, last_indexed_at
        FROM knowledge_document
        ORDER BY last_indexed_at DESC
    </select>

</mapper>
