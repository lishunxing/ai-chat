<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.lishunxing.aichat.mapper.ChatMemoryMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="cn.lishunxing.aichat.entity.ChatMemory">
        <id     column="id"              property="id" />
        <result column="conversation_id" property="conversationId" />
        <result column="message_type"    property="messageType" />
        <result column="content"         property="content" />
        <result column="created_at"      property="createdAt" />
    </resultMap>

    <!-- 根据会话ID查询最近N条消息 -->
    <select id="selectByConversationId" resultMap="BaseResultMap">
        SELECT id, conversation_id, message_type, content, created_at
        FROM chat_memory
        WHERE conversation_id = #{conversationId}
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <!-- 插入消息 -->
    <insert id="insertMessage" parameterType="cn.lishunxing.aichat.entity.ChatMemory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_memory (conversation_id, message_type, content)
        VALUES (#{conversationId}, #{messageType}, #{content})
    </insert>

</mapper>
